{
  "name": "crystal-index",
  "version": "1.0.0",
  "main": "index.js",
  "repository": "git@github.com:Sammii-HK/crystal-index.git",
  "author": "Samantha Kellow <sammii.h@icloud.com>",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "dev": "next dev",
    "build": "node scripts/check-ui-icons.mjs && node --test site-quality/icons.test.mjs && next build",
    "postbuild": "next-sitemap",
    "start": "next start",
    "lint": "node scripts/check-ui-icons.mjs && node --test site-quality/icons.test.mjs && next lint",
    "migrate": "npx prisma migrate dev",
    "test": "npm run test:icons && npm run test:catalogue && node --test tests/auth-dependency.test.mjs && jest --ci --forceExit",
    "vercel-build": "node scripts/check-ui-icons.mjs && node --test site-quality/icons.test.mjs && prisma generate && next build",
    "db:analyze": "tsx scripts/analyze-db-size.ts",
    "db:cleanup": "tsx scripts/cleanup-db.ts",
    "db:migrate-images": "tsx scripts/migrate-images-to-blob.ts",
    "db:remove-binary": "tsx scripts/remove-binary-images.ts",
    "test:identify": "tsx scripts/test-identification.ts",
    "test:crystals": "tsx scripts/test-multiple-crystals.ts",
    "test:random": "tsx scripts/test-random-crystals.ts",
    "test:watch": "jest --watch",
    "test:catalogue": "node --test tests/catalogue.test.mjs && tsx --tsconfig tests/tsconfig.json --experimental-test-module-mocks --import ./tests/dom-setup.mjs --test tests/catalogue-ui.test.tsx",
    "lint:icons": "node scripts/check-ui-icons.mjs",
    "test:icons": "node --test site-quality/icons.test.mjs"
  },
  "prisma": {
    "seed": "node --loader ts-node/esm prisma/seed.ts"
  },
  "pnpm": {
    "supportedArchitectures": {
      "os": [
        "current",
        "linux"
      ],
      "cpu": [
        "current",
        "x64"
      ]
    },
    "overrides": {
      "next@13.5.11>postcss": "8.5.33"
    }
  },
  "dependencies": {
    "@ai-sdk/anthropic": "^1.2.12",
    "@ai-sdk/openai": "^1.3.24",
    "@auth0/auth0-react": "^2.30.0",
    "@next-auth/prisma-adapter": "^1.0.7",
    "@prisma/client": "^5.22.0",
    "@react-three/drei": "^9.122.0",
    "@react-three/fiber": "^8.18.0",
    "@types/formidable": "^2.0.6",
    "@types/sharp": "^0.30.5",
    "@types/three": "^0.150.2",
    "@vercel/blob": "^0.20.0",
    "ai": "^5.0.292",
    "axios": "^0.26.1",
    "bulma": "^0.9.4",
    "classnames": "^2.5.1",
    "d3": "^4.13.0",
    "d3-geo": "^3.1.2",
    "formidable": "^2.1.5",
    "lucide-react": "^0.577.0",
    "next": "^13.5.11",
    "next-auth": "^4.24.15",
    "next-sitemap": "^4.2.3",
    "openai": "^4.104.0",
    "posthog-js": "^1.453.2",
    "posthog-node": "^3.6.3",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-responsive-carousel": "^3.2.23",
    "replicate": "^0.25.2",
    "sass": "^1.108.2",
    "sharp": "^0.33.5",
    "stripe": "^14.25.0",
    "three": "^0.152.2",
    "topojson": "^3.0.2",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^5.17.0",
    "@testing-library/react": "^13.4.0",
    "@types/node": "^20.19.43",
    "@types/react": "17.0.40",
    "dotenv": "^17.4.2",
    "eslint": "8.11.0",
    "eslint-config-next": "^13.5.11",
    "jest": "^27.5.1",
    "prisma": "^5.22.0",
    "ts-node": "^10.9.2",
    "tsx": "^4.23.15",
    "typescript": "4.6.2",
    "jsdom": "26.1.0"
  },
  "packageManager": "pnpm@10.12.4+sha512.5ea8b0deed94ed68691c9bad4c955492705c5eeb8a87ef86bc62c74a26b037b08ff9570f108b2e4dbd1dd1a9186fea925e527f141c648e85af45631074680184"
}
